{
  "rewrites": [
    {
      "source": "/downloads/:match*",
      "destination": "/downloads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Euphony.apk\""
        }
      ]
    },
    {
      "source": "/downloads/(.*)\\.exe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-msdownload"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Euphony-Setup.exe\""
        }
      ]
    }
  ]
}
