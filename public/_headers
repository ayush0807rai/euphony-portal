/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="Euphony.apk"
  Cache-Control: public, max-age=3600

/downloads/*.exe
  Content-Type: application/x-msdownload
  Content-Disposition: attachment; filename="Euphony-Setup.exe"
  Cache-Control: public, max-age=3600

/downloads/*.mobileconfig
  Content-Type: application/x-apple-aspen-config
  Content-Disposition: attachment; filename="Euphony.mobileconfig"
  Cache-Control: public, max-age=3600

/downloads/*.zip
  Content-Type: application/zip
  Content-Disposition: attachment; filename="Euphony-mac.zip"
  Cache-Control: public, max-age=3600


